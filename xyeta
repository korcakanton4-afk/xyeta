local function dump(name, text)
    if writefile then pcall(writefile, name, text) end
    if setclipboard then pcall(setclipboard, text) end
    notify(("дамп: %s (%d симв.)"):format(name, #text))
end

local function dumpLoot()
    local out = {}
    local pg = LP:FindFirstChild("PlayerGui")
    local mg = pg and pg:FindFirstChild("MainGui")
    if not mg then return dump("VeniceLoot.txt", "MainGui нет") end
    local function walk(inst, depth)
        if depth > 6 then return end
        out[#out+1] = string.rep("  ", depth) .. inst.Name .. " | " .. inst.ClassName
        for _, ch in ipairs(inst:GetChildren()) do walk(ch, depth + 1) end
    end
    walk(mg, 0)
    out[#out+1] = "--- CurrentContainer: " .. tostring(currentContainer())
    dump("VeniceLoot.txt", table.concat(out, "\n"))
end

local function dumpRemotes()
    local out = {}
    local rm = RS:FindFirstChild("Remotes")
    if rm then
        for _, r in ipairs(rm:GetChildren()) do
            out[#out+1] = r.Name .. " | " .. r.ClassName
            for _, ch in ipairs(r:GetChildren()) do out[#out+1] = "  " .. ch.Name .. " | " .. ch.ClassName end
        end
    end
    dump("VeniceRemotes.txt", table.concat(out, "\n"))
end

local function dumpFactions()
    local out = {}
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then
            out[#out+1] = pl.Name .. " | fac=" .. tostring(pl.Character:GetAttribute("Faction"))
        end
    end
    local z = WS:FindFirstChild("AiZones")
    if z then
        for _, zone in ipairs(z:GetChildren()) do
            for _, m in ipairs(zone:GetChildren()) do
                if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") then
                    out[#out+1] = "NPC " .. m.Name .. " | fac=" .. tostring(m:GetAttribute("Faction"))
                    break
                end
            end
        end
    end
    dump("VeniceFactions.txt", table.concat(out, "\n"))
end

