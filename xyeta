local L = {player = {}, npc = {}, body = {}, box = {}, item = {}, exit = {}, door = {}, trap = {}}
local TRAPS = {PMN2 = true, MON50 = true, GrenadeTrap = true}

local function clr(k) for i in pairs(L[k]) do L[k][i] = nil end end

local function scan()
    clr("player")
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and alive(pl.Character) then L.player[pl.Character] = pl.Name end
    end

    clr("npc")
    clr("trap")
    local z = WS:FindFirstChild("AiZones")
    if z then
        for _, zone in ipairs(z:GetChildren()) do
            local zl = zone.Name:lower()
            local isTrapZone = zl:find("mine") or zl:find("claymore")
            for _, m in ipairs(zone:GetChildren()) do
                if m:IsA("Model") then
                    if isTrapZone or TRAPS[m.Name] then
                        L.trap[m] = m.Name
                    elseif m:FindFirstChildOfClass("Humanoid") then
                        L.npc[m] = m.Name
                    end
                end
            end
        end
    end

    clr("body")
    for _, m in ipairs(WS:GetChildren()) do
        if m:IsA("Model") and not Players:GetPlayerFromCharacter(m) and not L.npc[m] then
            local h = m:FindFirstChildOfClass("Humanoid")
            if h and h.Health <= 0 then L.body[m] = true end
        end
    end

    clr("box")
    local ct = WS:FindFirstChild("Containers")
    if ct then
        for _, m in ipairs(ct:GetDescendants()) do
            if m:IsA("Model") and m:FindFirstChild("Inventory") and m:FindFirstChild("Properties") then
                L.box[m] = m:GetAttribute("DisplayName") or m.Name
            end
        end
    end

    clr("item")
    local di = WS:FindFirstChild("DroppedItems")
    if di then
        for _, m in ipairs(di:GetChildren()) do
            if m:IsA("Model") then L.item[m] = m.Name end
        end
    end

    clr("exit")
    clr("door")
    local nc = WS:FindFirstChild("NoCollision")
    if nc then
        local ex = nc:FindFirstChild("ExitLocations")
        if ex then for _, m in ipairs(ex:GetChildren()) do L.exit[m] = m.Name end end
        local pf = nc:FindFirstChild("PathFinding")
        local dp = pf and pf:FindFirstChild("DoorPass")
        if dp then for _, m in ipairs(dp:GetChildren()) do L.door[m] = true end end
    end
end

local function boxInfo(m)
    local inv = m:FindFirstChild("Inventory")
    if not inv then return "пусто", 0, 0 end
    local total, cnt = 0, 0
    local names = {}
    for _, it in ipairs(inv:GetChildren()) do
        cnt = cnt + 1
        total = total + priceOf(it.Name)
        if cnt <= 4 then names[#names+1] = it.Name end
    end
    if cnt == 0 then return "пусто", 0, 0 end
    return table.concat(names, ", ") .. (cnt > 4 and (" +" .. (cnt - 4)) or ""), total, cnt
end

local esp = {}
local function render(kind, on, maxD, lab)
    for inst, info in pairs(L[kind]) do
        local o = esp[inst]
        if on then
            local root = inst:FindFirstChild("HumanoidRootPart") or inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")
            local me = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if root and me then
                local d = (root.Position - me.Position).Magnitude
                local show = d <= maxD
                if kind == "box" and C.OnlyFilled then
                    local _, _, cnt = boxInfo(inst)
                    if cnt == 0 then show = false end
                end
                if show then
                    if not o then o = newEsp(kind); o.tgt = inst; esp[inst] = o end
                    local h = inst:FindFirstChildOfClass("Humanoid")
                    o:upd(root.Position, d, lab(inst, info), h and math.clamp(h.Health / math.max(h.MaxHealth, 1), 0, 1) or nil)
                elseif o then o:hide() end
            elseif o then o:hide() end
        elseif o then o:hide() end
    end
end

