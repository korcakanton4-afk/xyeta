            end
            notify("silent aim: установлен")
        else
            notify("silent aim: модуль Bullet не отдался", Color3.fromRGB(255, 120, 120))
        end
    else
        notify("silent aim: модуль Bullet не найден", Color3.fromRGB(255, 120, 120))
