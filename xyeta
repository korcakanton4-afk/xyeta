local SPY = {on = false}
local SPYFILE = "VeniceSpy.txt"
local spyBuf = {}
local SPYWATCH = {
    Door = true, QuickLoot = true, Loot = true, Take = true, QuickMove = true,
    InventoryMove = true, FireProjectile = true, Equip = true, Reload = true,
    ToggleAttachment = true, Build = true, PlaceObject = true,
}

local function spy(txt)
    if not SPY.on then return end
    spyBuf[#spyBuf+1] = ("[%s] %s\n"):format(os.date("%H:%M:%S"), txt)
    if #spyBuf > 400 then
        local chunk = table.concat(spyBuf)
        spyBuf = {}
        if appendfile then pcall(appendfile, SPYFILE, chunk)
        elseif writefile then pcall(writefile, SPYFILE, chunk) end
    end
end

local function sval(v, d)
    local t = typeof(v)
    if t == "Instance" then
        local ok, p = pcall(function() return v:GetFullName() end)
        return "INST<" .. (ok and p or v.Name) .. ">"
    elseif t == "string" then return ("%q"):format(v:sub(1, 120))
    elseif t == "table" then
        if (d or 0) >= 2 then return "{…}" end
        local o = {}
        for k, x in pairs(v) do o[#o+1] = tostring(k) .. "=" .. sval(x, (d or 0) + 1) end
        return "{" .. table.concat(o, ",") .. "}"
    end
    return tostring(v)
end

