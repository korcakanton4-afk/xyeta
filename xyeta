local function lootScroller()
    local pg = LP:FindFirstChild("PlayerGui")
    local mg = pg and pg:FindFirstChild("MainGui")
    local bp = mg and mg:FindFirstChild("BackpackFrame")
    local lt = bp and bp:FindFirstChild("Loot")
    local inv = lt and lt:FindFirstChild("Inventory")
    if not inv then return nil end
    for _, d in ipairs(inv:GetDescendants()) do
        if d:IsA("ScrollingFrame") then return d end
    end
    return nil
end

local function quickMove()
    local rm = RS:FindFirstChild("Remotes")
    return rm and rm:FindFirstChild("QuickMove")
end

local function lootGui()
    local sc = lootScroller()
    local qm = quickMove()
    if not (sc and qm) then return 0 end
    local sent = 0
    for _, grp in ipairs(sc:GetChildren()) do
        local fr = grp:FindFirstChild("Frame")
        if fr then
            for _, slot in ipairs(fr:GetChildren()) do
                local iv = slot:FindFirstChild("Item")
                if iv and iv:IsA("ObjectValue") and iv.Value then
                    if priceOf(iv.Value.Name) >= C.LootMin then
                        pcall(function() qm:FireServer(slot.Name, iv.Value.Parent) end)
                        sent = sent + 1
                    end
                end
            end
        end
    end
    return sent
end

local function currentContainer()
    local p  = RS:FindFirstChild("Players")
    local me = p and p:FindFirstChild(LP.Name)
    local st = me and me:FindFirstChild("Status")
    local gv = st and st:FindFirstChild("GameplayVariables")
    local cc = gv and gv:FindFirstChild("CurrentContainer")
    if not cc then return nil end
    local v = cc:IsA("ObjectValue") and cc.Value or cc
    if typeof(v) ~= "Instance" then return nil end
    return v
end

local function lootContainer()
    local c = currentContainer()
    local qm = quickMove()
    if not (c and qm) then return 0 end
    local inv = c:FindFirstChild("Inventory")
    if not inv then return 0 end
    local sent = 0
    for _, it in ipairs(inv:GetChildren()) do
        if priceOf(it.Name) >= C.LootMin then
            pcall(function() qm:FireServer(it.Name, it) end)
            pcall(function() qm:FireServer(it.Name, inv) end)
            sent = sent + 1
        end
    end
    return sent
end

local function lootAll()
    local a = lootGui()
    local b = lootContainer()
    if a + b == 0 then
        notify("лута нет (ящик не открыт или порог высокий)", Color3.fromRGB(255, 180, 60))
    else
        notify(("отправлено: %d"):format(a + b))
    end
