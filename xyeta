local function newEsp(kind)
    local col = CLR[kind] or CLR.player
    local o = {col = col, on = false}
    o.b = draw(Drawing.new("Square")); o.b.Thickness = 1; o.b.Filled = false; o.b.Color = col; o.b.Visible = false
    o.n = draw(Drawing.new("Text")); o.n.Size = 12; o.n.Font = 2; o.n.Center = true; o.n.Outline = true; o.n.Visible = false
    o.d = draw(Drawing.new("Text")); o.d.Size = 11; o.d.Font = 2; o.d.Center = true; o.d.Outline = true; o.d.Visible = false
    o.h = draw(Drawing.new("Line")); o.h.Thickness = 2; o.h.Visible = false
    o.t = draw(Drawing.new("Line")); o.t.Thickness = 1; o.t.Color = col; o.t.Visible = false

    function o:upd(pos, dist, label, hp)
        local cam = WS.CurrentCamera
        local hd = cam:WorldToViewportPoint(pos + Vector3.new(0, 1.1, 0))
        local ft = cam:WorldToViewportPoint(pos - Vector3.new(0, 2.4, 0))
        if not hd.Z or hd.Z <= 0 then return self:hide() end
        local hgt = math.abs(ft.Y - hd.Y)
        local w = hgt * 0.55
        local top = math.min(hd.Y, ft.Y)
        local lf = hd.X - w * 0.5
        self.on = true
        if C.Box then
            self.b.Visible = true
            self.b.Size = Vector2.new(w, hgt)
            self.b.Position = Vector2.new(lf, top)
            self.b.Color = self.col
        else self.b.Visible = false end
        if C.Name then
            self.n.Visible = true
            self.n.Text = label or ""
            self.n.Color = self.col
            self.n.Position = Vector2.new(hd.X, top - 15)
        else self.n.Visible = false end
        if C.Dist then
            self.d.Visible = true
            self.d.Text = ("%d m"):format(math.floor(dist / 3.5))
            self.d.Position = Vector2.new(hd.X, top + hgt + 2)
        else self.d.Visible = false end
        if hp then
            self.h.Visible = true
            self.h.From = Vector2.new(lf - 4, top + hgt)
            self.h.To = Vector2.new(lf - 4, top + hgt * (1 - hp))
            self.h.Color = Color3.fromRGB(255 * (1 - hp), 255 * hp, 60)
        else self.h.Visible = false end
        if C.Tracer then
            self.t.Visible = true
            self.t.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
            self.t.To = Vector2.new(hd.X, top + hgt)
        else self.t.Visible = false end
    end

    function o:hide()
        if not self.on then return end
        self.on = false
        for _, x in ipairs({self.b, self.n, self.d, self.h, self.t}) do x.Visible = false end
    end

    function o:kill()
        for _, x in ipairs({self.b, self.n, self.d, self.h, self.t}) do pcall(function() x:Remove() end) end
    end
    return o
end

