local FILE = "VenicePD.json"
local sync = {}
local function save()
    if not writefile then return end
    pcall(function()
        local t = {}
        for k, v in pairs(C) do
            t[k] = typeof(v) == "EnumItem" and ("E:" .. v.Name .. ":" .. tostring(v.EnumType)) or v
        end
        writefile(FILE, Http:JSONEncode(t))
    end)
end
local function load()
    if not (isfile and isfile(FILE) and readfile) then return end
    local ok, raw = pcall(readfile, FILE)
    if not ok or raw == "" then return end
    local ok2, d = pcall(function() return Http:JSONDecode(raw) end)
    if not ok2 or type(d) ~= "table" then return end
    for k, v in pairs(d) do
        if C[k] ~= nil then
            if type(v) == "string" and v:sub(1, 2) == "E:" then
                local nm, en = v:match("^E:([%w_]+):([%w_]+)$")
                local et = en and Enum[en]
                if et and nm and et[nm] then C[k] = et[nm] end
            else
                C[k] = v
            end
            if sync[k] then pcall(sync[k], C[k]) end
        end
    end
end

