local function nearestBox()
    local me = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not me then return end
    local best, bd = nil, 18
    for inst in pairs(L.box) do
        local r = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")
        if r then
            local d = (r.Position - me.Position).Magnitude
            if d < bd then bd = d best = r end
        end
    end
    if not best then return notify("рядом ящиков нет", Color3.fromRGB(255, 180, 60)) end
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, best.Position)
    task.wait(0.08)
    pcall(function() mouse1click() end)
end

local function passDoor()
    local me = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not me then return end
    local best, bd = nil, 45
    for inst in pairs(L.door) do
        if inst:IsA("BasePart") then
            local d = (inst.Position - me.Position).Magnitude
            if d < bd then bd = d best = inst end
        end
    end
    if not best then return notify("дверь не найдена", Color3.fromRGB(255, 180, 60)) end
    me.CFrame = CFrame.new(best.Position + Vector3.new(0, 3, 0))
    notify("прошёл дверь", Color3.fromRGB(150, 220, 255))
end

local function gotoExit()
    local me = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not me then return end
    local best, bd = nil, 1e6
    for inst in pairs(L.exit) do
        local r = inst:IsA("BasePart") and inst or inst:FindFirstChildWhichIsA("BasePart")
        if r then
            local d = (r.Position - me.Position).Magnitude
            if d < bd then bd = d best = r end
        end
    end
    if not best then return notify("выходов нет", Color3.fromRGB(255, 180, 60)) end
    me.CFrame = CFrame.new(best.Position + Vector3.new(0, 3, 0))
    notify(("выход: %d м"):format(math.floor(bd / 3.5)), Color3.fromRGB(150, 220, 255))
end

