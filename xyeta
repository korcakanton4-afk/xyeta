local function alive(ch)
    if not ch then return false end
    local h = ch:FindFirstChildOfClass("Humanoid")
    return h ~= nil and h.Health > 0 and ch:FindFirstChild("HumanoidRootPart") ~= nil
end

local function seen(p)
    local o = Camera.CFrame.Position
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {LP.Character, Camera, dummy}
    rp.IgnoreWater = true
    local hit = WS:Raycast(o, p.Position - o, rp)
    if not hit then return true end
    return hit.Instance:IsDescendantOf(p.Parent)
end

local BONES = {"Head", "HeadTopHitBox", "FaceHitBox", "HumanoidRootPart"}
local function bone(ch)
    if not ch then return nil end
    local order = {C.Bone}
    for _, b in ipairs(BONES) do order[#order+1] = b end
    for _, n in ipairs(order) do
        local p = ch:FindFirstChild(n)
        if p and p:IsA("BasePart") then return p end
    end
    return ch:FindFirstChildWhichIsA("BasePart")
end

local function target()
    local mid = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local best, bd = nil, C.Fov
    local function check(ch, nm)
        if not alive(ch) then return end
        local b = bone(ch)
        if not b then return end
        if C.WallCheck and not seen(b) then return end
        local sp, on = Camera:WorldToViewportPoint(b.Position)
        if not on then return end
        local dd = (Vector2.new(sp.X, sp.Y) - mid).Magnitude
        if dd < bd then bd = dd best = {p = b, ch = ch, nm = nm} end
    end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP then check(pl.Character, pl.Name) end
    end
    if C.NpcAim then
        local z = WS:FindFirstChild("AiZones")
        if z then
            for _, zone in ipairs(z:GetChildren()) do
                for _, m in ipairs(zone:GetChildren()) do
                    if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") then check(m, m.Name) end
                end
            end
        end
    end
    return best
end

local function predict(pos, origin, ammo)
    local spd  = attr(ammo, "MuzzleVelocity", 850)
    local drop = attr(ammo, "ProjectileDrop", 0)
    local tm   = (pos - origin).Magnitude / math.max(spd, 1)
    return pos + Vector3.new(0, 0.5 * (drop * 2) * tm * tm, 0)
end

local function aimPatch(args, n)
    local t = target()
    if not t then return end
    local idx
    for i = 1, n do
        local v = args[i]
        if typeof(v) == "Instance" and v:IsA("BasePart") and v.Name == "AimPart" then idx = i break end
    end
    if not idx then
        local v5 = args[5]
        if typeof(v5) == "Instance" and v5:IsA("BasePart") then idx = 5 end
    end
    if not idx then return end
    local origin = args[idx].Position
    local pos = t.p.Position
    if C.Predict then
        local ammo
        if type(args[7]) == "string" then ammo = args[7] end
        pos = predict(pos, origin, ammo) + (t.p.AssemblyLinearVelocity or Vector3.zero) *
            ((pos - origin).Magnitude / math.max(attr(ammo, "MuzzleVelocity", 850), 1))
    end
    dummy.CFrame = CFrame.new(origin, pos)
    args[idx] = dummy
end

local function projPatch(a, n)
    local t = target()
    if not t then return a, n end
    local origin = Camera.CFrame.Position
    local pos = t.p.Position
    for i = 1, n do
        local v = a[i]
        if typeof(v) == "Instance" and v:IsA("BasePart") and v.Name == "AimPart" then
            dummy.CFrame = CFrame.new(v.Position, pos)
            a[i] = dummy
            return a, n
        end
    end
    for i = 1, math.min(n, 4) do
        local v, ty = a[i], typeof(a[i])
        if ty == "CFrame" then
            a[i] = CFrame.new(v.Position, pos)
            return a, n
        elseif ty == "Vector3" then
            local d = pos - origin
            a[i] = d.Unit * math.max(v.Magnitude, 1)
            return a, n
        end
    end
    return a, n
end

