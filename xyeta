do
    local ok = pcall(function()
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local m = getnamecallmethod()
            if running then
                if SPY.on and (m == "FireServer" or m == "InvokeServer") and typeof(self) == "Instance" then
                    local nm = self.Name
                    if SPYWATCH[nm] then
                        local a, n = table.pack(...), select("#", ...)
                        local parts = {}
                        for i = 1, math.min(n, 8) do parts[i] = sval(a[i]) end
                        spy(("%s(%s) argc=%d %s"):format(nm, m, n, table.concat(parts, ", ")))
                    end
                end
                if m == "InvokeServer" and FireProj and self == FireProj and C.ProjPatch and aim.on and aim.held then
                    local a, n = table.pack(...), select("#", ...)
                    local okp, ra, rn = pcall(projPatch, a, n)
                    if okp and ra then return old(self, table.unpack(ra, 1, rn)) end
                end
            end
            return old(self, ...)
        end)
        setreadonly(mt, true)
    end)
    if not ok then notify("namecall: не установился", Color3.fromRGB(255, 120, 120)) end
end

