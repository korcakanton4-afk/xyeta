local function sld(par, txt, key, mn, mx, st)
    local h = Instance.new("Frame", par)
    h.Size = UDim2.new(1, 0, 0, 30)
    h.BackgroundTransparency = 1
    local lb = Instance.new("TextLabel", h)
    lb.Size = UDim2.new(1, -60, 0, 14)
    lb.BackgroundTransparency = 1
    lb.Font = Enum.Font.GothamMedium
    lb.TextSize = 12
    lb.TextXAlignment = Enum.TextXAlignment.Left
    lb.TextColor3 = Color3.fromRGB(200, 206, 218)
    lb.Text = txt
    local vv = Instance.new("TextLabel", h)
    vv.Size = UDim2.new(0, 60, 0, 14)
    vv.Position = UDim2.new(1, -60, 0, 0)
    vv.BackgroundTransparency = 1
    vv.Font = Enum.Font.GothamBold
    vv.TextSize = 12
    vv.TextXAlignment = Enum.TextXAlignment.Right
    vv.TextColor3 = Color3.fromRGB(90, 170, 255)
    vv.Text = tostring(C[key])
    local bar = Instance.new("Frame", h)
    bar.Size = UDim2.new(1, 0, 0, 5)
    bar.Position = UDim2.new(0, 0, 0, 19)
    bar.BackgroundColor3 = Color3.fromRGB(20, 23, 30)
    bar.BorderSizePixel = 0
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 2)
    local fl = Instance.new("Frame", bar)
    fl.Size = UDim2.new((C[key] - mn) / (mx - mn), 0, 1, 0)
    fl.BackgroundColor3 = Color3.fromRGB(90, 170, 255)
    fl.BorderSizePixel = 0
    Instance.new("UICorner", fl).CornerRadius = UDim.new(0, 2)
    local drag = false
    local function upd(x)
        local rt = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = mn + rt * (mx - mn)
        if st >= 1 then v = math.floor(v / st + 0.5) * st else v = math.floor(v * 100 + 0.5) / 100 end
        C[key] = v
        fl.Size = UDim2.new(rt, 0, 1, 0)
        vv.Text = tostring(v)
        save()
    end
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = true
            upd(i.Position.X)
            i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then drag = false end end)
        end
    end)
    track(UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            upd(i.Position.X)
        end
    end))
    sync[key] = function(v)
        local rt = math.clamp((v - mn) / (mx - mn), 0, 1)
        fl.Size = UDim2.new(rt, 0, 1, 0)
        vv.Text = tostring(v)
    end
end

